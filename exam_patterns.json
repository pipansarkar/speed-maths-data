 "templates": [
  {
   "id": "bank_qc_si_ci",
   "topic": "interest",
   "kind": "compare",
   "levels": [
    3,
    5
   ],
   "exams": [
    "bank"
   ],
   "vars": {
    "p": {
     "min": 2,
     "max": 20
    },
    "p2": {
     "min": 2,
     "max": 20
    },
    "r": [
     5,
     10,
     20
    ],
    "r2": [
     5,
     10,
     20
    ]
   },
   "let": {
    "P": "p * 1000",
    "P2": "p2 * 1000"
   },
   "prompt": "Quantity I: SI on ₹{P:inr} at {r}% p.a. for 2 years\nQuantity II: CI on ₹{P2:inr} at {r2}% p.a. for 2 years",
   "compare": [
    "P * r * 2 / 100",
    "P2 * ((1 + r2 / 100) ^ 2 - 1)"
   ],
   "where": [
    "isInt(q2)",
    "abs(q1 - q2) <= max(q1, q2) * 0.3"
   ]
  },
  {
   "id": "bank_qc_train_speed",
   "topic": "speedDistance",
   "kind": "compare",
   "levels": [
    2,
    5
   ],
   "exams": [
    "bank"
   ],
   "vars": {
    "k": {
     "min": 2,
     "max": 6
    },
    "t": {
     "min": 6,
     "max": 30
    },
    "d": {
     "min": -6,
     "max": 6
    }
   },
   "let": {
    "L": "5 * k * t",
    "v": "18 * k + d"
   },
   "prompt": "Quantity I: speed (km/h) of a train {L} m long that crosses a pole in {t} s\nQuantity II: {v} km/h",
   "compare": [
    "L / t * 18 / 5",
    "v"
   ],
   "where": [
    "v > 0"
   ]
  },
  {
   "id": "bank_qc_profit",
   "topic": "profitLoss",
   "kind": "compare",
   "levels": [
    3,
    5
   ],
   "exams": [
    "bank"
   ],
   "vars": {
    "c": {
     "min": 4,
     "max": 40
    },
    "p": [
     10,
     20,
     25,
     40,
     50
    ],
    "x": {
     "min": 5,
     "max": 60,
     "step": 5
    }
   },
   "let": {
    "CP": "c * 100",
    "SP": "CP * (100 + p) / 100"
   },
   "prompt": "Quantity I: profit % when CP = ₹{CP:inr} and SP = ₹{SP:inr}\nQuantity II: {x}%",
   "compare": [
    "(SP - CP) / CP * 100",
    "x"
   ]
  },
  {
   "id": "bank_qc_ratio_share",
   "topic": "ratio",
   "kind": "compare",
   "levels": [
    3,
    5
   ],
   "exams": [
    "bank"
   ],
   "vars": {
    "a": {
     "min": 1,
     "max": 9
    },
    "b": {
     "min": 1,
     "max": 9
    },
    "k": {
     "min": 2,
     "max": 60
    },
    "dd": {
     "min": -5,
     "max": 5
    }
   },
   "let": {
    "T": "(a + b) * k * 10",
    "y": "T * a / (a + b) + dd * 10"
   },
   "prompt": "Quantity I: A's share when ₹{T:inr} is divided between A and B in the ratio {a} : {b}\nQuantity II: ₹{y:inr}",
   "compare": [
    "T * a / (a + b)",
    "y"
   ],
   "where": [
    "gcd(a, b) == 1",
    "a != b",
    "y > 0"
   ]
  },
  {
   "id": "bank_caselet_pass",
   "topic": "percentage",
   "levels": [
    3,
    5
   ],
   "exams": [
    "bank",
    "ssc"
   ],
   "vars": {
    "n": {
     "min": 4,
     "max": 20
    },
    "p": [
     20,
     30,
     40,
     50,
     60
    ],
    "q": [
     20,
     40,
     50,
     60,
     80
    ],
    "s": [
     20,
     40,
     50,
     60,
     80
    ]
   },
   "let": {
    "N": "n * 50",
    "g": "N * p / 100",
    "b": "N - g"
   },
   "prompt": "In a school of {N} students, {p}% are girls. {q}% of the girls and {s}% of the boys passed.\nTotal students who passed = ?",
   "answer": "g * q / 100 + b * s / 100",
   "where": [
    "isInt(g * q / 100)",
    "isInt(b * s / 100)"
   ]
  },
  {
   "id": "bank_di_two_companies",
   "topic": "diCalc",
   "levels": [
    2,
    5
   ],
   "exams": [
    "bank"
   ],
   "vars": {
    "a": {
     "min": 100,
     "max": 900,
     "step": 20
    },
    "b": {
     "min": 100,
     "max": 900,
     "step": 10
    },
    "c": {
     "min": 100,
     "max": 900,
     "step": 10
    },
    "pc": [
     50,
     60,
     75,
     80,
     120,
     125,
     150
    ]
   },
   "let": {
    "d": "a * pc / 100"
   },
   "prompt": "Company A: 2023 → {a}, 2024 → {b}\nCompany B: 2023 → {c}, 2024 → {d}\nB's 2024 figure is what % of A's 2023 figure?",
   "answer": "d / a * 100",
